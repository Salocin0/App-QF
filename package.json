{
  "name": "qf-app",
  "main": "node_modules/expo/AppEntry.js",
  "version": "1.0.0",
  "node": "18.20.4",
  "scripts": {
    "start": "cross-env NODE_ENV=development npx expo start -c",
    "start-prod": "cross-env NODE_ENV=production npx expo start --dev-client -c",
    "start2": "npx expo start -c",
    "start:devclient": "cross-env NODE_ENV=development npx expo start --dev-client -c",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "cross-env NODE_ENV=development expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:win": "cd android && gradlew.bat assembleRelease",
    "build:apk": "npx expo export --platform android && cd android && ./gradlew assembleRelease",
    "build:apk:all": "npx expo export --platform android && cd android && ./gradlew assembleRelease -PpackageAssets=true -PbundleInDebug=true",
    "prebuild:prod": "npx expo prebuild --platform android --clean",
    "build:apk:prod": "npm run prebuild:prod && cd android && ./gradlew assembleRelease",
    "build:apk:prod:win": "npx expo prebuild --platform android && node -e \"require('fs').writeFileSync('android/local.properties', 'sdk.dir=C:/Users/nicol/AppData/Local/Android/Sdk')\" && cd android && cmd /c \"set ANDROID_HOME=C:\\Users\\nicol\\AppData\\Local\\Android\\Sdk&& gradlew.bat assembleRelease\"",
    "test": "jest ",
    "lint": "expo lint"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ]
  },

{
  "cli": {
    "version": ">= 9.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backendnode-qf.onrender.com",
        "NODE_VERSION": "20"
      },
      "android": {
        "buildType": "apk",
        "developmentClient": true,
        "distribution": "internal",
        "applicationArchivePath": "android/app/build/outputs/apk/debug/app-debug.apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://backendnode-qf.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "developmentClient": false,
        "distribution": "internal",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-release.apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
